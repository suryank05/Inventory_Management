# Copy this file to .env and fill in real values. Never commit .env.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

DB_URL=jdbc:mysql://localhost:3306/Inventory_manage
DB_USERNAME=root
DB_PASSWORD=change-me

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=Inventory_manage
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me-app

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-new-app-password
APP_MAIL_RECIPIENT=admin@example.com

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3002
